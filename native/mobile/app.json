{
  "expo": {
    "name": "TaskZen",
    "slug": "taskzen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.xrndev.taskzen"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": true,
      "package": "io.github.xrndev.taskzen"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "TaskZen necesita acceso a tus fotos para elegir portadas y avatares."
        }
      ]
    ],
    "scheme": "taskzen",
    "experiments": {
      "typedRoutes": true
    }
  }
}
