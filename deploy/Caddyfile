# Dirección anterior: redirige a la principal (temporal, para poder quitarla sin romper enlaces viejos).
{$LEGACY_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} temporary
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Subidas de hasta 50 MB (el tope del plan Pro; cada plan fija el suyo en la app) + cabeceras.
	request_body {
		max_size 60MB
	}

	# Descargas de las apps (APK). Se suben a /opt/taskzen/downloads sin reconstruir nada.
	handle_path /descargas/* {
		root * /srv/downloads
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		header Content-Disposition "attachment"
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy app:3000 {
			# Sin buffering para que el flujo SSE (/api/events) llegue al instante.
			flush_interval -1
		}
	}
}
